# harness/cells.env — the cell matrix: which commit × which image × which
# recipe (or host). Sourced by run-cell.sh / collect.sh / run-all.sh /
# summary.sh (config + helpers, not a standalone script). Cell ids and their
# meaning are in the root README.
#
# Five cells, letters fixed from here on:
#   A  original commit, reference environment  \
#   B  modernized commit, reference environment  } the code question
#   C  modernized commit, this Mac (host cell — not a container)
#   D  modernized commit, Ubuntu 24.04   \  the OS question:
#   E  modernized commit, Fedora 43       /  one variable vs B each
# (Letter history: these replaced an earlier, looser scheme — old C2's
# results became C, old E became D, old F became E, and the pre-harness
# "base on Mac doesn't build" probe was never a cell. Git history at the
# renaming commit keeps every earlier reading.)

CELLS="A B C D E"
HOST_CELLS="C"   # cells run bare on this machine instead of under podman

# --- reference environment (cells A, B) -------------------------------------
# One image for both cells: apt resolves exactly once and A and B cannot drift
# package-wise. Image id + dpkg -l manifest: runs/env-manifest.{A,B}.txt
CELL_IMAGE=dreal-ref:22.04
CELL_RECIPE=harness/Containerfile

# comparison runs pin explicit commit ids, never branch tips resolved at run time
CELL_A_COMMIT=f93bdcc26b62abdcc30ad7de6046729bb48016b9  # original, pre-modernization
CELL_B_COMMIT=e6d31b485d3ed828725e2c093c610031def17a3c  # modernize-macos tip

# --- host cell (C): the same modernized code on this Mac --------------------
# The submodule pin: cell B's code plus the macOS-only config/docs commits
# (.bazelrc Python 3.14 pin, python_configure error wording, README notes).
CELL_C_COMMIT=51c93b91571433618c70697f8242181a8cb0e384  # == submodule pin
# Cell C's ibex: a harness source-build of dreal-deps/ibex-lib@352eeeb — the
# exact commit cells A/B/D/E source-build (see install-ibex.sh) — instead of
# this Mac's Homebrew ibex@2.7.4 (=2.7.4_13, 2021 snapshot). run-cell.sh
# resolves it through harness/shim-bin/pkg-config; build it with:
#   PREFIX="$HOME/.local/opt/ibex-352eeeb" WAF_PY=/opt/homebrew/bin/python3.10 harness/install-ibex.sh
CELL_C_IBEX_PREFIX="${HOME}/.local/opt/ibex-352eeeb"

# --- OS-modernisation round: cell B's code on newer distributions ------------
# Exactly one variable changes per cell vs cell B: the OS. Everything the
# harness can hold constant, is: same commit, same ibex commit (source-built
# at /opt/libibex/2.7.4), same Bazel 7.0.0 (sha-pinned), same driver, same
# machine budget.
CELL_D_COMMIT=e6d31b485d3ed828725e2c093c610031def17a3c  # == cell B's commit
CELL_D_IMAGE=dreal-ref:24.04
CELL_D_RECIPE=harness/Containerfile.ubuntu-24.04

CELL_E_COMMIT=e6d31b485d3ed828725e2c093c610031def17a3c  # == cell B's commit
CELL_E_IMAGE=dreal-ref:fedora-43
CELL_E_RECIPE=harness/Containerfile.fedora-43

# --- accessors ---------------------------------------------------------------
cell_known() { case " $CELLS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

cell_kind() { # container | host
  case " $HOST_CELLS " in *" $1 "*) echo host ;; *) echo container ;; esac
}

_cell_var() { # _cell_var <CELL> <SUFFIX> <default>
  local v
  eval "v=\${CELL_$1_$2-}"
  printf '%s' "${v:-$3}"
}
cell_commit() { _cell_var "$1" COMMIT ""; }
cell_image()  { [ "$(cell_kind "$1")" = host ] && return 0; _cell_var "$1" IMAGE "$CELL_IMAGE"; }
cell_recipe() { [ "$(cell_kind "$1")" = host ] && return 0; _cell_var "$1" RECIPE "$CELL_RECIPE"; }

cell_ensure_image() { # build the cell's image if its tag is missing (REBUILD=1 forces)
  local img recipe root
  [ "$(cell_kind "$1")" = host ] && return 0
  img=$(cell_image "$1"); recipe=$(cell_recipe "$1")
  root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  if [ "${REBUILD:-0}" = 1 ] || ! podman image exists "$img"; then
    if [ "${REBUILD:-0}" = 1 ]; then
      echo "REBUILD=1 — rebuilding image $img from $recipe"
    else
      echo "image $img missing — building from $recipe (first time; ~10 min)"
    fi
    podman build -t "$img" -f "$root/$recipe" "$root"
  fi
}
