#!/usr/bin/env bash
#
# T-d trial shims (hypotheses.md): run cell C's bazel with brew gcc-16.
#
# bazel's apple config glues Apple-clang dialect into every CppCompile
# (`-mmacos-version-min=11.0`) plus clang-only warning switches. gcc spells
# the deployment-target flag differently and rejects the warning names
# outright (see the shakeout record in report.md, T-d). This shim translates
# the one semantic flag and drops the six purely-diagnostic ones — the code
# under test, optimization level, and machine are untouched.
#
# Link-side duties (same trial, found attempt-by-attempt): expand @file
# params before filtering; add -lstdc++ (gcc doesn't auto-link C++ runtime);
# put the gcc-built gmpxx first on -L — Homebrew's libgmpxx is
# clang/libc++-ABI-built and gcc's std::ostream mangling doesn't resolve
# against it (nlopt/clp/coinutils link clean; gmpxx is the only clash).
#
# Named gcc-16-compat / g++-16-compat (symlink); dispatch on $0.
set -euo pipefail

case "$0" in
  *g++*) real=/opt/homebrew/bin/g++-16 ;;
  *)     real=/opt/homebrew/bin/gcc-16 ;;
esac

args=()
raw=()
# gcc/bazel pass link+compile flags in @response files; those would reach
# real gcc unfiltered (the bug found in T-d attempt 2), so expand first.
for a in "$@"; do
  if [ "${a#@}" != "$a" ] && [ -r "${a#@}" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && raw+=("$line")
    done < "${a#@}"
  else
    raw+=("$a")
  fi
done
for a in "${raw[@]}"; do
  case "$a" in
    -mmacos-version-min=*) a="-mmacosx-version-min=${a#-mmacos-version-min=}" ;;
    -Wthread-safety|-Wself-assign|-fcolor-diagnostics|\
    -Winconsistent-missing-override|-Wreturn-stack-address|\
    -no-canonical-prefixes|-fobjc-link-runtime) continue ;;
  esac
  args+=("$a")
done
# bazel's CppLink goes through the CC (gcc, not g++): gcc never auto-links
# libstdc++ → every C++ link dies on std::__cxx11 symbols (attempt 3).
# Add it for link-shaped invocations only (nothing when -c/-E/-S/--syntax).
link=1
for a in "${args[@]}"; do
  case "$a" in -c|-E|-S|-fsyntax-only|-M|-MM) link=0 ;; esac
done
if [ "$link" = 1 ]; then
  args+=("-lstdc++")
  _gmp=/Users/josh/.local/opt/gmp-gcc16/lib
  [ -d "$_gmp" ] && args=(-L"$_gmp" "${args[@]}")
fi
exec "$real" "${args[@]}"
